input {
    keyboard {
        repeat-rate 50
        repeat-delay 200

        xkb {
            layout "us,rs"
            variant ",yz";
            options "caps:escape,grp:alt_shift_toggle";
        }
        numlock
    }

    touchpad {
        off
    }
    trackpoint {
        off
    }
    mouse {
        accel-profile "flat"
    }

    focus-follows-mouse max-scroll-amount="0%"
}

spawn-at-startup "awww-daemon"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/user/media/screenshots/%Y-%m-%d_%H-%M-%S.png"

include "appearance.kdl"
include "keybinds.kdl"
