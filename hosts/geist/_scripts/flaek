#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
    flaek update [ARGS...]
    flaek upgrade [PATH#HOST] [ARGS...]
    flaek diff
    flaek help

Commands:
    update   Run nix flake update, forwarding any extra arguments.
    upgrade  Rebuild and switch, then compare the active system before and after.
             Pass arguments after --flake unchanged; default to . with no arguments.
    diff     Compare the two latest system generations.
    help     Show this help.
EOF
}

diff_generations() {
    local profile="/nix/var/nix/profiles/system"
    local listing old new
    local -a generations

    listing=$(nix-env --list-generations --profile "$profile")
    mapfile -t generations < <(
        awk '{print $1}' <<< "$listing" | tail -n 2
    )

    if [[ ${#generations[@]} -ne 2 ]]; then
        echo "Could not find two system generations." >&2
        return 1
    fi

    old="${generations[0]}"
    new="${generations[1]}"

    echo
    echo "Comparing generation $old → $new"
    echo

    nix store diff-closures \
        "$profile-${old}-link" \
        "$profile-${new}-link"
}

case "${1:-}" in
    update)
        shift
        nix flake update "$@"
        ;;
    upgrade)
        shift
        if [[ $# -eq 0 ]]; then
            set -- .
        fi
        before=$(readlink -e /run/current-system)
        nixos-rebuild switch --flake "$@"
        after=$(readlink -e /run/current-system)
        echo
        echo "Comparing system before → after upgrade"
        echo
        nix store diff-closures "$before" "$after"
        ;;
    diff)
        diff_generations
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
